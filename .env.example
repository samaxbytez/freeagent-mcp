# FreeAgent OAuth2 credentials (from Developer Dashboard)
FREEAGENT_CLIENT_ID=your_client_id_here
FREEAGENT_CLIENT_SECRET=your_client_secret_here

# Set to "true" to use the FreeAgent sandbox instead of production
# FREEAGENT_SANDBOX=true

# Set to "true" to enable user management, invoice emailing, adding bank
# accounts and changing a contact's email
# FREEAGENT_ENABLE_SENSITIVE_TOOLS=true

# Directory attachment_path may read receipts from. Required to attach files to
# expenses and bills; without it attachment_path is refused.
# FREEAGENT_ATTACHMENTS_DIR=/path/to/receipts

# Legacy: provide a token directly (skips OAuth flow)
# FREEAGENT_ACCESS_TOKEN=your_access_token_here
