{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run type-check)",
      "Bash(npm run build)",
      "Bash(npx vitest run)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git log --oneline -20)",
      "Bash(git show --stat HEAD)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "files=$(git ls-files -m -o --exclude-standard -- 'src/**/*.ts'); [ -z \"$files\" ] || printf '%s\\n' \"$files\" | xargs npx --no-install prettier --write >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
